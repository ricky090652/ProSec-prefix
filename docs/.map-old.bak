<title>Prefix-ProSec 實驗地圖</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=IBM+Plex+Sans:wght@400;500;600&family=Newsreader:opsz,wght@6..72,500;6..72,600&family=Noto+Sans+TC:wght@400;500;700&family=Noto+Serif+TC:wght@600;700&display=swap">

<style>
:root{
  --paper:#eef1ef; --surface:#ffffff; --surface-2:#e3e9e6; --sunk:#e7ecea;
  --ink:#141b1a; --ink-2:#495652; --ink-3:#6f7e7a;
  --rule:#ccd6d2; --rule-2:#dde4e1;
  --teal:#0c6a5f; --teal-soft:#d2e7e2;
  --rust:#a63d2a; --rust-soft:#f5dcd5;
  --ochre:#906312; --ochre-soft:#f1e5c6;
  --violet:#5a4b8c; --violet-soft:#e2ddf0;
  --font-display:"Newsreader","Noto Serif TC",Georgia,serif;
  --font-body:"IBM Plex Sans","Noto Sans TC",system-ui,sans-serif;
  --font-mono:"IBM Plex Mono","Noto Sans TC",ui-monospace,monospace;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --paper:#0c110f; --surface:#131a18; --surface-2:#1b2422; --sunk:#0f1614;
    --ink:#e1e8e5; --ink-2:#a2b0ac; --ink-3:#7b8985;
    --rule:#28322f; --rule-2:#1f2926;
    --teal:#5bd0bd; --teal-soft:#12332f;
    --rust:#f0917a; --rust-soft:#391d17;
    --ochre:#dcae55; --ochre-soft:#32270f;
    --violet:#b3a6e0; --violet-soft:#231d3a;
  }
}
:root[data-theme="dark"]{
  --paper:#0c110f; --surface:#131a18; --surface-2:#1b2422; --sunk:#0f1614;
  --ink:#e1e8e5; --ink-2:#a2b0ac; --ink-3:#7b8985;
  --rule:#28322f; --rule-2:#1f2926;
  --teal:#5bd0bd; --teal-soft:#12332f;
  --rust:#f0917a; --rust-soft:#391d17;
  --ochre:#dcae55; --ochre-soft:#32270f;
  --violet:#b3a6e0; --violet-soft:#231d3a;
}

*{box-sizing:border-box}
body{
  margin:0; background:var(--paper); color:var(--ink);
  font-family:var(--font-body); font-size:16px; line-height:1.72;
  -webkit-font-smoothing:antialiased;
}
.wrap{
  display:grid; grid-template-columns:216px minmax(0,1fr);
  gap:48px; max-width:1180px; margin:0 auto; padding:0 28px 120px;
}

/* ---------- nav rail ---------- */
nav{position:sticky; top:0; align-self:start; padding-top:56px; max-height:100vh; overflow-y:auto}
nav .brand{font-family:var(--font-mono); font-size:11px; letter-spacing:.16em;
  text-transform:uppercase; color:var(--ink-3); margin-bottom:18px}
nav ol{list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:2px}
nav a{
  display:flex; gap:9px; align-items:baseline; text-decoration:none; color:var(--ink-2);
  font-size:13.5px; line-height:1.45; padding:5px 8px; border-radius:3px;
  border-left:2px solid transparent;
}
nav a:hover{color:var(--ink); background:var(--surface-2)}
nav a:focus-visible{outline:2px solid var(--teal); outline-offset:2px}
nav a .n{font-family:var(--font-mono); font-size:10.5px; color:var(--ink-3); min-width:14px}

/* ---------- masthead ---------- */
header.top{padding:64px 0 40px; border-bottom:1px solid var(--rule); margin-bottom:44px}
header.top .eyebrow{
  font-family:var(--font-mono); font-size:11.5px; letter-spacing:.18em;
  text-transform:uppercase; color:var(--teal); margin-bottom:14px;
}
header.top h1{
  font-family:var(--font-display); font-weight:600; font-size:clamp(34px,5vw,52px);
  line-height:1.12; margin:0 0 16px; letter-spacing:-.01em; text-wrap:balance;
}
header.top p.lede{font-size:17.5px; color:var(--ink-2); margin:0; max-width:62ch}
header.top .meta{
  display:flex; flex-wrap:wrap; gap:8px 22px; margin-top:26px;
  font-family:var(--font-mono); font-size:12px; color:var(--ink-3);
}

/* ---------- sections ---------- */
section{margin-bottom:76px; scroll-margin-top:24px}
h2{
  font-family:var(--font-display); font-weight:600; font-size:29px; line-height:1.25;
  margin:0 0 6px; letter-spacing:-.005em; text-wrap:balance;
}
h2 .sn{font-family:var(--font-mono); font-size:13px; color:var(--teal);
  display:block; letter-spacing:.14em; margin-bottom:8px; font-weight:400}
h3{font-family:var(--font-body); font-weight:600; font-size:18.5px; margin:38px 0 10px; letter-spacing:-.003em}
h4{font-family:var(--font-mono); font-weight:600; font-size:13px; letter-spacing:.06em;
  text-transform:uppercase; color:var(--ink-3); margin:26px 0 8px}
p{margin:0 0 14px; max-width:70ch}
ul,ol{margin:0 0 16px; padding-left:22px; max-width:70ch}
li{margin-bottom:7px}
li::marker{color:var(--ink-3)}
a{color:var(--teal)}
strong{font-weight:600; color:var(--ink)}
code{font-family:var(--font-mono); font-size:.875em; background:var(--surface-2);
  padding:1px 5px; border-radius:3px; color:var(--ink)}
hr{border:0; border-top:1px solid var(--rule-2); margin:34px 0}
.sub{color:var(--ink-2); font-size:15px; max-width:70ch}

/* ---------- chips ---------- */
.chip{
  display:inline-flex; align-items:center; gap:5px; font-family:var(--font-mono);
  font-size:11px; letter-spacing:.06em; padding:2px 8px; border-radius:100px;
  border:1px solid; vertical-align:middle; white-space:nowrap;
}
.chip.done{color:var(--teal); border-color:var(--teal); background:var(--teal-soft)}
.chip.now{color:var(--ochre); border-color:var(--ochre); background:var(--ochre-soft)}
.chip.todo{color:var(--ink-3); border-color:var(--rule); background:var(--surface-2)}
.chip.dead{color:var(--rust); border-color:var(--rust); background:var(--rust-soft)}

/* ---------- tables ---------- */
.tw{overflow-x:auto; margin:18px 0 22px; border:1px solid var(--rule); border-radius:5px; background:var(--surface)}
table{border-collapse:collapse; width:100%; font-size:14px; min-width:min-content}
th,td{padding:9px 13px; text-align:left; border-bottom:1px solid var(--rule-2); vertical-align:top}
thead th{
  font-family:var(--font-mono); font-size:11px; letter-spacing:.07em; text-transform:uppercase;
  color:var(--ink-3); background:var(--sunk); border-bottom:1px solid var(--rule); font-weight:600;
  white-space:nowrap;
}
tbody tr:last-child td{border-bottom:0}
td.num,th.num{text-align:right; font-family:var(--font-mono); font-variant-numeric:tabular-nums; white-space:nowrap}
td.mono{font-family:var(--font-mono); font-size:12.5px; white-space:nowrap}
.good{color:var(--teal); font-weight:600}
.bad{color:var(--rust); font-weight:600}
.warn{color:var(--ochre); font-weight:600}
tr.hl td{background:var(--teal-soft)}
tr.dim td{color:var(--ink-3)}

/* ---------- callouts ---------- */
.note{
  border-left:3px solid var(--teal); background:var(--surface); padding:15px 18px;
  margin:20px 0; border-radius:0 4px 4px 0; font-size:15px; max-width:72ch;
}
.note.alert{border-left-color:var(--rust)}
.note.gate{border-left-color:var(--ochre)}
.note .lbl{
  font-family:var(--font-mono); font-size:10.5px; letter-spacing:.14em; text-transform:uppercase;
  color:var(--teal); display:block; margin-bottom:6px; font-weight:600;
}
.note.alert .lbl{color:var(--rust)}
.note.gate .lbl{color:var(--ochre)}
.note p:last-child{margin-bottom:0}

/* ---------- formula ---------- */
.eq{
  background:var(--sunk); border:1px solid var(--rule-2); border-radius:5px;
  padding:16px 20px; margin:16px 0; font-family:var(--font-mono); font-size:14px;
  line-height:2; overflow-x:auto; color:var(--ink);
}
.eq .cm{color:var(--ink-3)}
.eq .hi{color:var(--teal); font-weight:600}
.eq .hi2{color:var(--rust); font-weight:600}

/* ---------- figures ---------- */
figure{margin:26px 0; padding:0}
figure svg{display:block; width:100%; max-width:100%; height:auto; font-family:var(--font-body)}
figcaption{
  font-size:13.5px; color:var(--ink-2); margin-top:10px; line-height:1.6;
  border-top:1px solid var(--rule-2); padding-top:9px; max-width:74ch;
}
figcaption b{color:var(--ink); font-weight:600}

/* ---------- cards ---------- */
.cards{display:grid; gap:14px; margin:20px 0}
.cards.two{grid-template-columns:repeat(auto-fit,minmax(280px,1fr))}
.cards.three{grid-template-columns:repeat(auto-fit,minmax(210px,1fr))}
.card{background:var(--surface); border:1px solid var(--rule); border-radius:5px; padding:16px 18px}
.card h5{margin:0 0 8px; font-size:15px; font-weight:600; font-family:var(--font-body)}
.card .k{font-family:var(--font-mono); font-size:10.5px; letter-spacing:.12em;
  text-transform:uppercase; color:var(--ink-3); display:block; margin-bottom:7px}
.card p{font-size:14px; margin:0; color:var(--ink-2)}
.card p + p{margin-top:9px}

.stat{display:flex; flex-direction:column; gap:2px}
.stat .v{font-family:var(--font-mono); font-size:26px; font-weight:600;
  font-variant-numeric:tabular-nums; letter-spacing:-.02em}
.stat .l{font-size:12.5px; color:var(--ink-2)}

/* ---------- step block ---------- */
.step{border:1px solid var(--rule); border-radius:6px; background:var(--surface);
  margin:22px 0; overflow:hidden}
.step > header{
  display:flex; flex-wrap:wrap; align-items:baseline; gap:12px;
  padding:13px 18px; background:var(--sunk); border-bottom:1px solid var(--rule);
}
.step > header .id{font-family:var(--font-mono); font-weight:600; font-size:15px; color:var(--teal)}
.step > header .ti{font-weight:600; font-size:16px; flex:1}
.step .body{padding:16px 18px}
.step .body p{max-width:none}
.step .body ul{max-width:none}
.step dl{margin:0; display:grid; grid-template-columns:auto 1fr; gap:6px 14px; font-size:14.5px}
.step dt{font-family:var(--font-mono); font-size:11px; letter-spacing:.08em; text-transform:uppercase;
  color:var(--ink-3); padding-top:4px; white-space:nowrap}
.step dd{margin:0}

@media (max-width:900px){
  .wrap{grid-template-columns:1fr; gap:0; padding:0 20px 80px}
  nav{position:static; max-height:none; padding-top:28px;
    border-bottom:1px solid var(--rule); padding-bottom:16px}
  nav ol{flex-direction:row; flex-wrap:wrap; gap:4px}
  header.top{padding-top:34px}
}
@media (prefers-reduced-motion:reduce){*{transition:none!important; animation:none!important}}
</style>

<div class="wrap">

<nav>
  <div class="brand">Prefix-ProSec</div>
  <ol>
