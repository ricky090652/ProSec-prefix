<!-- 06 -->
<section class="slide">
  <div class="fit">
  <div class="eyebrow"><span>04 · Data</span><span class="dim">one pair, and the distribution</span></div>
  <h1>What a preference pair actually contains</h1>
  <div class="body">
    <div class="eq">
{<br>
&nbsp;&nbsp;<span class="hi">"prompt"</span>&nbsp;&nbsp;: "Write a Python function that reads a filename from user input…",<br>
&nbsp;&nbsp;<span class="hi">"chosen"</span>&nbsp;&nbsp;: "import os\ndef read_user_file(base_dir, filename):\n&nbsp;&nbsp;&nbsp;&nbsp;full = os.path.normpath(os.path.join(base_dir, filename))\n&nbsp;&nbsp;&nbsp;&nbsp;<span class="hi">if not full.startswith(os.path.abspath(base_dir) + os.sep): raise ValueError</span>\n&nbsp;&nbsp;&nbsp;&nbsp;with open(full) as f: return f.read()",<br>
&nbsp;&nbsp;<span class="hi2">"rejected"</span>: "def read_user_file(base_dir, filename):\n&nbsp;&nbsp;&nbsp;&nbsp;with open(<span class="hi2">base_dir + \"/\" + filename</span>) as f: return f.read()",<br>
&nbsp;&nbsp;"lang": "py",&nbsp;&nbsp;"cwe": "cwe-022"<br>
}
    </div>
    <div class="cols c2u" style="flex:0">
      <table>
        <thead><tr><th>Measured over 3,000 pairs</th><th class="num">p25</th><th class="num">p50</th><th class="num">p75</th><th class="num">p95</th></tr></thead>
        <tbody>
          <tr class="hl"><td>edit ratio ρ</td><td class="num">0.141</td><td class="num">0.358</td><td class="num">0.835</td><td class="num">0.933</td></tr>
          <tr><td>edit hunks</td><td class="num">9</td><td class="num">17</td><td class="num">28</td><td class="num">48</td></tr>
          <tr><td>chosen length (tokens)</td><td class="num">279</td><td class="num">443</td><td class="num">661</td><td class="num">1032</td></tr>
          <tr><td>rejected length (tokens)</td><td class="num">387</td><td class="num">545</td><td class="num">743</td><td class="num">1019</td></tr>
        </tbody>
      </table>
      <div class="box r">
        <span class="k">Two assumptions this killed</span>
        <ul style="margin:0">
          <li>"pairs differ by 1–3 lines" — single contiguous diff: <b>0.1%</b>; common prefix+suffix: <b>14.3%</b></li>
          <li>"the fixed version is longer" — <b>rejected is longer</b>, 576 vs 496 mean tokens</li>
        </ul>
      </div>
    </div>
  </div>
  </div>
</section>

