        <tr><td>chosen per-token probability retained</td><td class="num">88.8%</td><td class="num good">94.6%</td><td>the prefix disturbed the base model less</td></tr>
        <tr><td>rewards/margins</td><td class="num good">4.11</td><td class="num">0.82</td><td>LoRA trained harder</td></tr>
        <tr class="dim"><td>rewards/accuracies</td><td class="num">0.975</td><td class="num">0.753</td><td>not diagnostic on its own</td></tr>
        <tr><td>grad_norm peak</td><td class="num">87</td><td class="num bad">18,657</td><td>5 spikes, decreasing, <b>chosen recovered after each</b> (−3.24 → −1.27)</td></tr>
