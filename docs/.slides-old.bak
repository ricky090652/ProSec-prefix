<title>Prefix-ProSec Progress Review</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=IBM+Plex+Sans:wght@400;500;600&family=Newsreader:opsz,wght@6..72,500;6..72,600&display=swap">

<style>
:root{
  --paper:#eef1ef; --surface:#ffffff; --surface-2:#e3e9e6; --sunk:#e7ecea;
  --ink:#141b1a; --ink-2:#495652; --ink-3:#6f7e7a;
  --rule:#ccd6d2; --rule-2:#dde4e1;
  --teal:#0c6a5f; --teal-soft:#d2e7e2;
  --rust:#a63d2a; --rust-soft:#f5dcd5;
  --ochre:#906312; --ochre-soft:#f1e5c6;
  --violet:#5a4b8c; --violet-soft:#e2ddf0;
  --font-display:"Newsreader",Georgia,serif;
  --font-body:"IBM Plex Sans",system-ui,sans-serif;
  --font-mono:"IBM Plex Mono",ui-monospace,monospace;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --paper:#0a0f0e; --surface:#131a18; --surface-2:#1b2422; --sunk:#0f1614;
    --ink:#e1e8e5; --ink-2:#a2b0ac; --ink-3:#7b8985;
    --rule:#28322f; --rule-2:#1f2926;
    --teal:#5bd0bd; --teal-soft:#12332f;
    --rust:#f0917a; --rust-soft:#391d17;
    --ochre:#dcae55; --ochre-soft:#32270f;
    --violet:#b3a6e0; --violet-soft:#231d3a;
  }
}
:root[data-theme="dark"]{
  --paper:#0a0f0e; --surface:#131a18; --surface-2:#1b2422; --sunk:#0f1614;
  --ink:#e1e8e5; --ink-2:#a2b0ac; --ink-3:#7b8985;
  --rule:#28322f; --rule-2:#1f2926;
  --teal:#5bd0bd; --teal-soft:#12332f;
  --rust:#f0917a; --rust-soft:#391d17;
  --ochre:#dcae55; --ochre-soft:#32270f;
  --violet:#b3a6e0; --violet-soft:#231d3a;
}

*{box-sizing:border-box}
body{
  margin:0; background:var(--paper); color:var(--ink);
  font-family:var(--font-body); -webkit-font-smoothing:antialiased;
  display:flex; flex-direction:column; align-items:center;
  min-height:100vh; overflow:hidden;
}

#stage{
  position:relative;
  width:min(100vw, calc((100vh - 56px) * 16 / 9));
  aspect-ratio:16/9;
  container-type:size;
  background:var(--surface);
  border:1px solid var(--rule);
  overflow:hidden;
  margin-top:8px;
}
.slide{position:absolute; inset:0; padding:3.6cqw 4.6cqw 3.2cqw; display:none; flex-direction:column}
.slide.on{display:flex}
.fit{flex:1; min-height:0; display:flex; flex-direction:column; transform-origin:top left}
.title-slide .fit{justify-content:center}

.eyebrow{
  font-family:var(--font-mono); font-size:1.14cqw; letter-spacing:.2em;
  text-transform:uppercase; color:var(--teal); margin-bottom:.8cqw;
  display:flex; gap:1.4cqw; align-items:baseline;
}
.eyebrow .dim{color:var(--ink-3); letter-spacing:.14em}
h1{
  font-family:var(--font-display); font-weight:600; font-size:3.0cqw; line-height:1.14;
  margin:0 0 1.05cqw; letter-spacing:-.012em; text-wrap:balance;
}
h1.big{font-size:5cqw}
h2{font-family:var(--font-body); font-weight:600; font-size:1.5cqw; margin:0 0 .5cqw}
.sub{font-size:1.34cqw; color:var(--ink-2); line-height:1.5; margin:0 0 .85cqw; max-width:80ch}
.body{flex:1; min-height:0; display:flex; flex-direction:column; gap:.85cqw}

ul{margin:0; padding-left:1.5cqw; font-size:1.36cqw; line-height:1.46}
ul.tight{font-size:1.22cqw; line-height:1.4}
li{margin-bottom:.42cqw}
li::marker{color:var(--teal)}
strong,b{font-weight:600}
code{font-family:var(--font-mono); font-size:.86em; background:var(--surface-2); padding:.05em .3em; border-radius:.25em}
em{font-style:italic}
.good{color:var(--teal); font-weight:600}
.bad{color:var(--rust); font-weight:600}
.warn{color:var(--ochre); font-weight:600}
.vio{color:var(--violet); font-weight:600}
s{opacity:.6}

.cols{display:grid; gap:1.05cqw; flex:1; min-height:0}
.cols > *{min-width:0}
.c2{grid-template-columns:1fr 1fr}
.c3{grid-template-columns:repeat(3,1fr)}
.c2u{grid-template-columns:1.15fr .85fr}
.c2v{grid-template-columns:.8fr 1.2fr}

.box{
  background:var(--sunk); border:1px solid var(--rule-2); border-radius:.5cqw;
  padding:1.02cqw 1.22cqw; display:flex; flex-direction:column; gap:.34cqw;
}
.box.t{border-color:var(--teal); background:var(--teal-soft)}
.box.r{border-color:var(--rust); background:var(--rust-soft)}
.box.o{border-color:var(--ochre); background:var(--ochre-soft)}
.box.v{border-color:var(--violet); background:var(--violet-soft)}
.box .k{font-family:var(--font-mono); font-size:.95cqw; letter-spacing:.13em; text-transform:uppercase; color:var(--ink-3)}
.box.t .k{color:var(--teal)} .box.r .k{color:var(--rust)}
.box.o .k{color:var(--ochre)} .box.v .k{color:var(--violet)}
.box h3{margin:0; font-size:1.36cqw; font-weight:600; font-family:var(--font-body); line-height:1.24}
.box p{margin:0; font-size:1.18cqw; line-height:1.42; color:var(--ink-2)}
.box p b{color:var(--ink)}
.box ul{font-size:1.18cqw; line-height:1.42; padding-left:1.2cqw}

table{border-collapse:collapse; width:100%; font-size:1.15cqw}
th,td{padding:.34cqw .56cqw; text-align:left; border-bottom:1px solid var(--rule-2); line-height:1.34}
thead th{
  font-family:var(--font-mono); font-size:.9cqw; letter-spacing:.07em; text-transform:uppercase;
  color:var(--ink-3); background:var(--sunk); border-bottom:1px solid var(--rule); font-weight:600; white-space:nowrap;
}
tbody tr:last-child td{border-bottom:0}
td.num,th.num{text-align:right; font-family:var(--font-mono); font-variant-numeric:tabular-nums; white-space:nowrap}
td.mono{font-family:var(--font-mono); font-size:1.04cqw; white-space:nowrap}
tr.hl td{background:var(--teal-soft); font-weight:600}
tr.dim td{color:var(--ink-3)}

.eq{
  background:var(--sunk); border:1px solid var(--rule-2); border-radius:.4cqw;
  padding:.72cqw 1cqw; font-family:var(--font-mono); font-size:1.08cqw; line-height:1.6; overflow:hidden;
}
.eq.lg{font-size:1.22cqw; line-height:1.8}
.eq .cm{color:var(--ink-3)}
.eq .hi{color:var(--teal); font-weight:600}
.eq .hi2{color:var(--rust); font-weight:600}

figure{margin:0; flex:1; min-height:0; display:flex; flex-direction:column; justify-content:center}
figure svg{display:block; width:100%; height:auto; max-height:100%; font-family:var(--font-body)}
figcaption{font-size:1.08cqw; color:var(--ink-2); margin-top:.55cqw; line-height:1.4; border-top:1px solid var(--rule-2); padding-top:.42cqw}
figcaption b{color:var(--ink); font-weight:600}

.call{border-left:.3cqw solid var(--teal); background:var(--sunk); padding:.7cqw 1cqw; font-size:1.2cqw; line-height:1.42}
.call.r{border-left-color:var(--rust)}
.call.o{border-left-color:var(--ochre)}
.call.v{border-left-color:var(--violet)}
.call .k{display:block; font-family:var(--font-mono); font-size:.9cqw; letter-spacing:.12em; text-transform:uppercase; color:var(--teal); margin-bottom:.22cqw; font-weight:600}
.call.r .k{color:var(--rust)} .call.o .k{color:var(--ochre)} .call.v .k{color:var(--violet)}

.chip{display:inline-flex; align-items:center; font-family:var(--font-mono); font-size:.98cqw; letter-spacing:.05em; padding:.08cqw .5cqw; border-radius:2cqw; border:1px solid}
.chip.done{color:var(--teal); border-color:var(--teal); background:var(--teal-soft)}
.chip.now{color:var(--ochre); border-color:var(--ochre); background:var(--ochre-soft)}
.chip.dead{color:var(--rust); border-color:var(--rust); background:var(--rust-soft)}

.title-slide{justify-content:center}
.title-slide .rule{width:9cqw; height:.3cqw; background:var(--teal); margin-bottom:2cqw}
.title-slide .meta{display:flex; gap:2.2cqw; flex-wrap:wrap; margin-top:2.2cqw; font-family:var(--font-mono); font-size:1.18cqw; color:var(--ink-3)}
.title-slide .meta b{color:var(--ink); font-weight:600}

#bar{
  width:min(100vw, calc((100vh - 56px) * 16 / 9));
  display:flex; align-items:center; gap:14px; padding:8px 4px 0;
  font-family:var(--font-mono); font-size:12px; color:var(--ink-3);
}
#bar .track{flex:1; height:3px; background:var(--rule); border-radius:2px; overflow:hidden}
#bar .fill{height:100%; background:var(--teal); width:0; transition:width .18s ease}
#bar button{font:inherit; font-size:12px; color:var(--ink-2); background:var(--surface); border:1px solid var(--rule); border-radius:3px; padding:3px 10px; cursor:pointer}
#bar button:hover{color:var(--ink); border-color:var(--teal)}
#bar button:focus-visible{outline:2px solid var(--teal); outline-offset:2px}
#counter{font-variant-numeric:tabular-nums; min-width:52px}

@media (prefers-reduced-motion:reduce){#bar .fill{transition:none}}

@media print{
  body{overflow:visible; display:block}
  #bar{display:none}
  #stage{width:100%; border:0; margin:0; aspect-ratio:auto; container-type:normal}
  .slide{display:flex!important; position:relative; inset:auto; break-after:page; height:100vh; padding:40px 48px}
  .eyebrow{font-size:11px} h1{font-size:29px} h1.big{font-size:42px}
  .sub,ul{font-size:14px} .box h3{font-size:15px} .box p,.box ul{font-size:13px}
  table{font-size:12px} .eq{font-size:12px} figcaption{font-size:11px} .call{font-size:13px}
}
</style>

<div id="stage">

<!-- 01 -->
<section class="slide title-slide">
  <div class="fit">
  <div class="rule"></div>
  <div class="eyebrow"><span>Progress Review</span><span class="dim">2026-09-03</span></div>
  <h1 class="big">Prefix-ProSec</h1>
  <p class="sub" style="font-size:1.9cqw; max-width:56ch">A pluggable security module for code LLMs —<br>ProSec's data and pipeline, with a prefix in place of LoRA.</p>
  <div class="meta">
    <span>Phi-3-mini-4k-instruct</span>
    <span>45,785 preference pairs</span>
    <span>DPO · β=0.05</span>
    <span>Both arms trained</span>
  </div>
  </div>
</section>

<!-- 02 -->
<section class="slide">
  <div class="fit">
  <div class="eyebrow"><span>01 · Motivation</span><span class="dim">how we got here</span></div>
  <h1>The idea survived; the foundation was replaced</h1>
  <div class="body">
<figure>
      <svg viewBox="0 0 880 250" role="img" aria-label="Project lineage: the original plan was to replace SVEN's method with DPO, but SVEN's models and environment are outdated; the prefix idea was kept and moved onto ProSec's modern data and pipeline, where it replaces LoRA">
        <defs>
          <marker id="lnar" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5.5" markerHeight="5.5" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 z" fill="currentColor"/></marker>
          <marker id="lnarT" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5.5" markerHeight="5.5" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 z" fill="var(--teal)"/></marker>
        </defs>

        <rect x="14" y="16" width="372" height="94" rx="5" fill="var(--surface)" stroke="var(--rule)" stroke-width="1.4"/>
        <text x="28" y="36" font-size="12.5" font-weight="600" fill="currentColor">SVEN (2023) — where we started</text>
        <text x="28" y="56" font-size="10.5" fill="var(--teal)">✔ prefix tuning steers a security property</text>
        <text x="28" y="72" font-size="10.5" fill="var(--teal)">✔ freezes the base model entirely</text>
        <text x="28" y="88" font-size="10.5" fill="var(--rust)">✘ CodeGen (2022), torch 1.13 — almost nothing reusable</text>
        <text x="28" y="104" font-size="10.5" fill="var(--rust)">✘ real-world GitHub-commit data, small and noisy</text>

        <rect x="494" y="16" width="372" height="94" rx="5" fill="var(--surface)" stroke="var(--rule)" stroke-width="1.4"/>
        <text x="508" y="36" font-size="12.5" font-weight="600" fill="currentColor">ProSec (2025) — where we moved</text>
        <text x="508" y="56" font-size="10.5" fill="var(--teal)">✔ proactively synthesized vulnerability data</text>
        <text x="508" y="72" font-size="10.5" fill="var(--teal)">✔ static analyzer as the labelling oracle</text>
        <text x="508" y="88" font-size="10.5" fill="var(--teal)">✔ preference optimization on a modern model</text>
        <text x="508" y="104" font-size="10.5" fill="var(--ochre)">— adapts with <tspan font-weight="600">LoRA</tspan></text>

        <path d="M200 114 L330 152" stroke="var(--teal)" stroke-width="2" fill="none" marker-end="url(#lnarT)"/>
        <text x="196" y="140" font-size="10.5" font-weight="600" fill="var(--teal)">keep the idea</text>

        <path d="M680 114 L550 152" stroke="currentColor" stroke-width="2" fill="none" marker-end="url(#lnar)"/>
        <text x="618" y="140" font-size="10.5" font-weight="600" fill="currentColor">move onto the foundation</text>

        <rect x="150" y="158" width="580" height="72" rx="5" fill="var(--teal-soft)" stroke="var(--teal)" stroke-width="1.8"/>
        <text x="440" y="180" text-anchor="middle" font-size="13" font-weight="600" fill="currentColor">This work — ProSec's data and pipeline, with a <tspan fill="var(--teal)">prefix instead of LoRA</tspan></text>
        <text x="440" y="200" text-anchor="middle" font-size="10.5" fill="currentColor">Phi-3-mini-4k-instruct · transformers 4.46 · PEFT 0.19 · TRL 0.12</text>
        <text x="440" y="219" text-anchor="middle" font-size="10.5" font-weight="600" fill="var(--teal)">Everything except the PEFT method is held fixed, so the difference is attributable.</text>
      </svg>
      <figcaption><b>SVEN had the idea but a stack two generations old; ProSec had the data, the analyzer oracle and a current model — but uses LoRA.</b></figcaption>
    </figure>
  </div>
  </div>
</section>

<!-- 03 -->
<section class="slide">
  <div class="fit">
  <div class="eyebrow"><span>02 · The change</span><span class="dim">prefix vs LoRA</span></div>
  <h1>Where each one enters the model</h1>
  <div class="body">
<figure>
      <svg viewBox="0 0 880 250" role="img" aria-label="Injection points: LoRA adds a low-rank delta to the weight matrices with its gradient returning along the residual path, while a prefix prepends virtual tokens to the key-value sequence and can only act through softmax attention weights">
        <defs>
          <marker id="s7ar" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5.5" markerHeight="5.5" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 z" fill="currentColor"/></marker>
          <marker id="s7arv" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5.5" markerHeight="5.5" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 z" fill="var(--violet)"/></marker>
          <marker id="s7art" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5.5" markerHeight="5.5" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 z" fill="var(--teal)"/></marker>
        </defs>
        <line x1="440" y1="10" x2="440" y2="240" stroke="var(--rule)" stroke-width="1" stroke-dasharray="4 4"/>
        <text x="20" y="22" font-size="12.5" font-weight="600" fill="var(--violet)">LoRA — into the weights</text>
        <rect x="20" y="34" width="392" height="150" rx="5" fill="var(--surface)" stroke="var(--rule)" stroke-width="1.2"/>
        <rect x="38" y="66" width="66" height="28" rx="3" fill="var(--sunk)" stroke="currentColor" stroke-width="1"/>
        <text x="71" y="85" text-anchor="middle" font-size="10.5" fill="currentColor">hidden h</text>
        <path d="M108 80 L142 80" stroke="currentColor" stroke-width="1.3" marker-end="url(#s7ar)"/>
        <rect x="146" y="60" width="86" height="40" rx="3" fill="var(--sunk)" stroke="var(--ink-3)" stroke-width="1" stroke-dasharray="4 3"/>
        <text x="189" y="77" text-anchor="middle" font-size="10.5" fill="var(--ink-3)">W_qkv,o,mlp ❄</text>
        <text x="189" y="92" text-anchor="middle" font-size="9.5" fill="var(--ink-3)">frozen</text>
        <rect x="146" y="118" width="86" height="40" rx="3" fill="var(--violet-soft)" stroke="var(--violet)" stroke-width="1.5"/>
        <text x="189" y="135" text-anchor="middle" font-size="11" font-weight="600" fill="var(--violet)">ΔW = BA</text>
        <text x="189" y="150" text-anchor="middle" font-size="9.5" fill="var(--violet)">× alpha/r = 2</text>
        <path d="M189 114 L189 104" stroke="var(--violet)" stroke-width="1.5" marker-end="url(#s7arv)"/>
        <text x="238" y="114" font-size="10" fill="var(--violet)">added directly</text>
        <path d="M236 80 L276 80" stroke="currentColor" stroke-width="1.3" marker-end="url(#s7ar)"/>
        <rect x="280" y="60" width="106" height="40" rx="3" fill="var(--surface-2)" stroke="currentColor" stroke-width="1"/>
        <text x="333" y="84" text-anchor="middle" font-size="10.5" fill="currentColor">attention output</text>
        <path d="M333 158 L333 106" stroke="var(--violet)" stroke-width="2" stroke-dasharray="6 3" fill="none" marker-end="url(#s7arv)"/>
        <text x="333" y="174" text-anchor="middle" font-size="10" font-weight="600" fill="var(--violet)">gradient returns along the residual</text>
        <text x="20" y="204" font-size="10.5" fill="currentColor">literature lr <tspan font-family="var(--font-mono)" font-weight="600">1e-4 ~ 5e-4</tspan> — <tspan fill="var(--ink-3)">measured best here: 5e-6 under DPO</tspan></text>
        <text x="20" y="222" font-size="10.5" fill="var(--ink-3)">switching adapters needs merge / unmerge</text>

        <text x="466" y="22" font-size="12.5" font-weight="600" fill="var(--teal)">Prefix — into the sequence</text>
        <rect x="466" y="34" width="394" height="150" rx="5" fill="var(--surface)" stroke="var(--rule)" stroke-width="1.2"/>
        <text x="480" y="60" font-size="10" fill="var(--ink-3)">key / value sequence</text>
        <rect x="480" y="66" width="15" height="24" rx="2" fill="var(--teal)"/>
        <rect x="498" y="66" width="15" height="24" rx="2" fill="var(--teal)"/>
        <rect x="516" y="66" width="15" height="24" rx="2" fill="var(--teal)"/>
        <text x="505" y="106" text-anchor="middle" font-size="9.5" font-weight="600" fill="var(--teal)">16 virtual tokens</text>
        <rect x="540" y="66" width="11" height="24" rx="2" fill="var(--surface-2)" stroke="var(--ink-3)" stroke-width=".8"/>
        <rect x="554" y="66" width="11" height="24" rx="2" fill="var(--surface-2)" stroke="var(--ink-3)" stroke-width=".8"/>
        <rect x="568" y="66" width="11" height="24" rx="2" fill="var(--surface-2)" stroke="var(--ink-3)" stroke-width=".8"/>
        <rect x="582" y="66" width="11" height="24" rx="2" fill="var(--surface-2)" stroke="var(--ink-3)" stroke-width=".8"/>
        <rect x="596" y="66" width="11" height="24" rx="2" fill="var(--surface-2)" stroke="var(--ink-3)" stroke-width=".8"/>
        <rect x="610" y="66" width="11" height="24" rx="2" fill="var(--surface-2)" stroke="var(--ink-3)" stroke-width=".8"/>
        <rect x="624" y="66" width="11" height="24" rx="2" fill="var(--surface-2)" stroke="var(--ink-3)" stroke-width=".8"/>
        <rect x="638" y="66" width="11" height="24" rx="2" fill="var(--surface-2)" stroke="var(--ink-3)" stroke-width=".8"/>
        <rect x="652" y="66" width="11" height="24" rx="2" fill="var(--surface-2)" stroke="var(--ink-3)" stroke-width=".8"/>
        <rect x="666" y="66" width="11" height="24" rx="2" fill="var(--surface-2)" stroke="var(--ink-3)" stroke-width=".8"/>
        <text x="612" y="106" text-anchor="middle" font-size="9.5" fill="var(--ink-3)">hundreds of real context tokens ❄</text>
        <path d="M688 78 L724 78" stroke="currentColor" stroke-width="1.3" marker-end="url(#s7ar)"/>
        <rect x="728" y="58" width="106" height="42" rx="3" fill="var(--surface-2)" stroke="currentColor" stroke-width="1"/>
        <text x="781" y="75" text-anchor="middle" font-size="10.5" fill="currentColor">softmax attention</text>
        <text x="781" y="90" text-anchor="middle" font-size="10.5" fill="currentColor">→ output</text>
        <path d="M781 158 L781 106" stroke="var(--teal)" stroke-width="2" stroke-dasharray="6 3" fill="none" marker-end="url(#s7art)"/>
        <text x="660" y="174" text-anchor="middle" font-size="10" font-weight="600" fill="var(--teal)">gradient only through softmax weights — 16 / (16 + hundreds) of the mass</text>
        <text x="466" y="204" font-size="10.5" fill="currentColor">literature lr <tspan font-family="var(--font-mono)" font-weight="600">1e-3 ~ 1e-2</tspan> (SFT scale) — <tspan fill="var(--ink-3)">measured best here: 5e-5</tspan></text>
        <text x="466" y="222" font-size="10.5" fill="var(--ink-3)">switching = swapping past_key_values → ≈ zero cost</text>
      </svg>
      <figcaption><b>Because they enter the graph differently, their gradient scales differ by orders of magnitude — so a shared learning rate would not be fairness, it would make one side underfit.</b></figcaption>
    </figure>
    <table style="flex:0">
      <thead><tr><th></th><th>LoRA r=8, all-linear</th><th>Prefix nvt=16</th></tr></thead>
      <tbody>
        <tr><td>Trainable parameters</td><td class="num">12,582,912</td><td class="num good">3,145,728</td></tr>
        <tr><td>Adapter size <span style="color:var(--ink-3)">(bf16, from param count)</span></td><td class="num">≈ 25.2 MB</td><td class="num good">≈ 6.3 MB</td></tr>
        <tr><td>Acts on</td><td>weight matrices — <code>ΔW = BA</code></td><td>the key/value sequence, every layer</td></tr>
        <tr><td>Gradient reaches it via</td><td>the residual path, scaled by α/r</td><td>softmax attention weights only</td></tr>
        <tr class="hl"><td>Best learning rate <span style="color:var(--ink-3)">(measured, equal budget)</span></td><td class="num">5e-6</td><td class="num">5e-5 — <b>10×</b></td></tr>
        <tr><td>Switching policies</td><td>merge / unmerge weights</td><td class="good">swap <code>past_key_values</code></td></tr>
        <tr><td>Mixed policies in one batch</td><td>needs special support</td><td class="good">native</td></tr>
      </tbody>
    </table>
  </div>
  </div>
</section>

<!-- 04 -->
<section class="slide">
  <div class="fit">
  <div class="eyebrow"><span>03 · Scope</span><span class="dim">against the paper</span></div>
  <h1>What we changed, and what we added</h1>
  <div class="body">
    <table>
      <thead><tr><th></th><th>ProSec paper</th><th>This work</th><th>Reason</th></tr></thead>
      <tbody>
        <tr class="hl"><td>PEFT method</td><td>LoRA r=8, α=16</td><td><b>Prefix nvt=16</b></td><td>the object of study</td></tr>
        <tr><td>Objective</td><td>SimPO · β=1.5, γ=0.5</td><td><b>DPO · β=0.05</b></td><td>SimPO destabilized in our runs; the paper's own appendix validates DPO on this data — and the objective is a control variable, shared by both arms</td></tr>
        <tr><td>Training length</td><td>1500 steps @ batch 64</td><td>800 steps @ batch 64</td><td>≈ 1.1 epoch over 45,785</td></tr>
        <tr><td>LoRA target modules</td><td>not specified</td><td>all-linear <span class="mono">(qkv, o, gate_up, down)</span></td><td>our assumption — must be declared</td></tr>
        <tr><td>Eval subset</td><td>38 ⟨lang, CWE⟩ / 694 cases<br><span style="color:var(--ink-3)">never released</span></td><td><b>36 ⟨lang, CWE⟩ / 693 cases</b><br><span style="color:var(--ink-3)">reconstructed</span></td><td>had to be rebuilt from PurpleLlama ∩ SafeCoder</td></tr>
        <tr class="hl"><td>Generation-quality checks</td><td class="bad">none</td><td class="good"><b>8 checks</b></td><td>the security metric can be faked — slides 12–14</td></tr>
      </tbody>
    </table>
  </div>
  </div>
</section>

